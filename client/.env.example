# ── Client environment ────────────────────────────────────────────────────────
# Copy to .env.local for development, or set these in the Vercel project settings.
# Only VITE_-prefixed variables reach the browser, and everything here is public by design:
# there are no client-side secrets any more — the API holds the Mongo and Gemini credentials.

# Base URL of the ASP.NET Core API.
# Leave blank in development: the Vite dev server proxies /api to VITE_API_PROXY_TARGET.
# Set it on Vercel to your Render service, e.g. https://resumon-api.onrender.com
VITE_API_BASE_URL=

# Where the dev proxy forwards /api. Matches the "http" profile in
# server/src/Resumon.Api/Properties/launchSettings.json.
VITE_API_PROXY_TARGET=http://localhost:5233
